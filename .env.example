# SEC-03: copie este archivo como .env (en la misma carpeta) y ponga su
# contrasena. .env NO se sube al repo: esta en .gitignore.
#
# La lee la app (spring.config.import en application.properties) y la lee
# docker compose para crear la base. Si su base de Docker ya existia, use la
# contrasena con que se creo (en los sprints 1 a 5 era "registro").
DB_URL=jdbc:postgresql://localhost:5432/registro_naves
DB_USER=registro
DB_PASSWORD=cambie-esta-contrasena
